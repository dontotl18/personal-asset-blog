---
import type { BlogPost } from '../utils/posts';
import PostCard from './PostCard.astro';

interface Props {
	posts: BlogPost[];
	label: string;
}

const { posts, label } = Astro.props;
---

<section aria-label={label}>
	{posts.length > 0 ? (
		<div class="post-list">
			{posts.map((post) => <PostCard post={post} />)}
		</div>
	) : (
		<p class="empty-state">아직 공개된 글이 없습니다.</p>
	)}
</section>
