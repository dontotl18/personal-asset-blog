---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { CategoryDefinition } from '../utils/categories';
import type { BlogPost } from '../utils/posts';
import BlogPostList from './BlogPostList.astro';
import CategoryFilter from './CategoryFilter.astro';

interface Props {
	posts: BlogPost[];
	categories: CategoryDefinition[];
	activeCategory?: CategoryDefinition;
}

const { posts, categories, activeCategory } = Astro.props;
const listLabel = activeCategory ? `${activeCategory.label} 글 목록` : '전체 글 목록';
---

<BaseLayout title="Blog" description="개발기와 기술 문제 해결 기록 전체 목록">
	<section class="page-header page-header--blog shell">
		<div class="page-header-content">
			<p class="section-kicker">ALL NOTES</p>
			<h1>Blog</h1>
			<p>프로젝트 개발기와 재사용 가능한 기술 정리를 한곳에서 확인합니다.</p>
		</div>
	</section>

	<div class="section shell">
		<div class="blog-listing">
			<CategoryFilter categories={categories} activeSlug={activeCategory?.slug} />
			<BlogPostList posts={posts} label={listLabel} />
		</div>
	</div>
</BaseLayout>

<style>
	.blog-listing {
		max-width: 900px;
		margin-inline: auto;
	}
</style>
